{
  "$description": "Design tokens for the Governed Agent Platform UI, in the W3C Design Tokens Community Group format. This file is the single source of truth. src/styles/tokens.css is generated from it by `npm run tokens`. The groups `light` and `dark` are the two colour sets.",
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Geist", "system-ui", "-apple-system", "Segoe UI", "sans-serif"], "$description": "UI text. Self-hosted from the geist package." },
    "mono": { "$value": ["Geist Mono", "ui-monospace", "SFMono-Regular", "monospace"], "$description": "Ids, hashes, reason codes and policy keys." }
  },
  "text": {
    "$type": "dimension",
    "display": {
      "$value": "3.25rem",
      "$description": "Landing headline. Fluid: it grows with the viewport between the min and the value.",
      "$extensions": { "gap.fluid": { "min": "2.25rem", "preferred": "4vw" } }
    },
    "title-1": { "$value": "1.75rem", "$description": "Page title." },
    "title-2": { "$value": "1.25rem", "$description": "Section title." },
    "headline": { "$value": "1rem", "$description": "Card and group title." },
    "body": { "$value": "0.9375rem", "$description": "Running text." },
    "callout": { "$value": "0.875rem", "$description": "Dense UI text." },
    "footnote": { "$value": "0.8125rem", "$description": "Table cells and captions." },
    "caption": { "$value": "0.6875rem", "$description": "Eyebrows and chips." }
  },
  "leading": {
    "$type": "number",
    "display": { "$value": 1.05 },
    "title-1": { "$value": 1.15 },
    "title-2": { "$value": 1.25 },
    "headline": { "$value": 1.35 },
    "body": { "$value": 1.55 },
    "callout": { "$value": 1.45 },
    "footnote": { "$value": 1.4 },
    "caption": { "$value": 1.3 }
  },
  "tracking": {
    "$type": "dimension",
    "display": { "$value": "-0.025em" },
    "title-1": { "$value": "-0.02em" },
    "title-2": { "$value": "-0.012em" },
    "headline": { "$value": "-0.006em" },
    "body": { "$value": "0em" },
    "callout": { "$value": "0em" },
    "footnote": { "$value": "0.005em" },
    "caption": { "$value": "0.06em" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px", "$description": "Console cards, inputs, buttons, table frames." },
    "md": { "$value": "12px", "$description": "Workspace cards and dialogs." },
    "lg": { "$value": "16px", "$description": "Large panels." },
    "xl": { "$value": "24px", "$description": "Landing page only." },
    "full": { "$value": "9999px", "$description": "Chips and badges." }
  },
  "layout": {
    "$type": "dimension",
    "sidebar-width": { "$value": "248px" },
    "topbar-height": { "$value": "56px" },
    "content-max": { "$value": "1080px" },
    "row-compact": { "$value": "32px", "$description": "Console table row, default density." },
    "row-comfortable": { "$value": "40px", "$description": "Console table row, comfortable density." },
    "drawer-width": { "$value": "520px" }
  },
  "material": {
    "$type": "dimension",
    "blur": { "$value": "24px", "$description": "Backdrop blur on fixed bars only." }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "press": { "$value": "100ms" },
      "fast": { "$value": "150ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "250ms" }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0, 0, 1], "$description": "Default easing for entering and moving things." },
      "in-out": { "$value": [0.4, 0, 0.2, 1] }
    },
    "press-scale": { "$type": "number", "$value": 0.97 }
  },
  "light": {
    "$type": "color",
    "bg-canvas": { "$value": "#F6F4EF", "$description": "Page background. Warm paper." },
    "bg-surface": { "$value": "#FDFCFA", "$description": "Cards, tables, drawers." },
    "bg-muted": { "$value": "#EFECE5", "$description": "Inputs, table heads, quiet fills." },
    "bg-selected": { "$value": "rgba(24, 24, 27, 0.06)", "$description": "Selected row and active nav item." },
    "hairline": { "$value": "#E3DFD6", "$description": "Borders and dividers." },
    "ink": { "$value": "#18181B", "$description": "Near-black. Primary buttons and the logo mark." },
    "ink-hover": { "$value": "#34343A" },
    "text-primary": { "$value": "#18181B" },
    "text-secondary": { "$value": "#5E5B55" },
    "text-tertiary": { "$value": "#6B675F" },
    "text-on-ink": { "$value": "#FDFCFA", "$description": "Text on an ink button." },
    "seal": { "$value": "#0B5D6E", "$description": "The one accent. Logo dot, links, focus rings and rare landing highlights." },
    "seal-pressed": { "$value": "#084A58" },
    "seal-tint": { "$value": "rgba(11, 93, 110, 0.10)" },
    "allow": { "$value": "#146B41" },
    "deny": { "$value": "#BF2A22" },
    "escalate": { "$value": "#8F5600" },
    "allow-tint": { "$value": "rgba(20, 107, 65, 0.10)" },
    "deny-tint": { "$value": "rgba(191, 42, 34, 0.10)" },
    "escalate-tint": { "$value": "rgba(143, 86, 0, 0.10)" },
    "success": { "$value": "{light.allow}" },
    "warning": { "$value": "{light.escalate}" },
    "danger": { "$value": "{light.deny}" },
    "success-tint": { "$value": "{light.allow-tint}" },
    "warning-tint": { "$value": "{light.escalate-tint}" },
    "danger-tint": { "$value": "{light.deny-tint}" },
    "material-thin": { "$value": "rgba(253, 252, 250, 0.72)" },
    "scrim": { "$value": "rgba(24, 24, 27, 0.40)" },
    "shadow-sm": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(24, 24, 27, 0.04)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }]
    },
    "shadow-md": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(24, 24, 27, 0.05)", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-8px" }]
    },
    "shadow-lg": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(24, 24, 27, 0.06)", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-12px" }]
    }
  },
  "dark": {
    "$type": "color",
    "bg-canvas": { "$value": "#131312" },
    "bg-surface": { "$value": "#1C1B19" },
    "bg-muted": { "$value": "#242320" },
    "bg-selected": { "$value": "rgba(236, 234, 228, 0.08)" },
    "hairline": { "$value": "#2D2B27" },
    "ink": { "$value": "#ECEAE4" },
    "ink-hover": { "$value": "#F7F5EF" },
    "text-primary": { "$value": "#ECEAE4" },
    "text-secondary": { "$value": "#A39F97" },
    "text-tertiary": { "$value": "#9A968E" },
    "text-on-ink": { "$value": "#131312" },
    "seal": { "$value": "#5DB7C4" },
    "seal-pressed": { "$value": "#7BC8D3" },
    "seal-tint": { "$value": "rgba(93, 183, 196, 0.14)" },
    "allow": { "$value": "#4CD38A" },
    "deny": { "$value": "#FF7A72" },
    "escalate": { "$value": "#F2B04A" },
    "allow-tint": { "$value": "rgba(76, 211, 138, 0.14)" },
    "deny-tint": { "$value": "rgba(255, 122, 114, 0.14)" },
    "escalate-tint": { "$value": "rgba(242, 176, 74, 0.14)" },
    "success": { "$value": "{dark.allow}" },
    "warning": { "$value": "{dark.escalate}" },
    "danger": { "$value": "{dark.deny}" },
    "success-tint": { "$value": "{dark.allow-tint}" },
    "warning-tint": { "$value": "{dark.escalate-tint}" },
    "danger-tint": { "$value": "{dark.deny-tint}" },
    "material-thin": { "$value": "rgba(28, 27, 25, 0.72)" },
    "scrim": { "$value": "rgba(8, 8, 7, 0.60)" },
    "shadow-sm": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(0, 0, 0, 0.14)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }]
    },
    "shadow-md": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(0, 0, 0, 0.22)", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-8px" }]
    },
    "shadow-lg": {
      "$type": "shadow",
      "$value": [{ "color": "rgba(0, 0, 0, 0.30)", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-12px" }]
    }
  }
}
