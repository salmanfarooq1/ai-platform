# .env.example — Template for all environment variables
# Copy to .env.local, .env.public-preview, or .env.prod and fill in real values.
# NEVER commit real credentials. This file is safe to commit.

# Deployment mode: "local", "public-preview", or "prod"
MODE=local

# ---- LLM ----
# Override model selection (optional — defaults are set per MODE in config.py)
# LLM_MODEL=ollama/llama3
# EMBED_MODEL=ollama/nomic-embed-text
# Ordered, comma separated embedding fallbacks, tried when the primary fails. A model whose vectors are not
# EMBEDDING_DIM wide is refused. Empty by default.
# EMBED_FALLBACK_MODELS=
# Changing EMBED_MODEL makes every stored chunk stale (ignored by search, counted in /v1/health) until it is re-embedded.

# Azure OpenAI (prod mode only)
# AZURE_OAI_BASE=https://your-resource.openai.azure.com/
# AZURE_OAI_KEY=your-key-here

# Groq (public-preview mode only)
# GROQ_API_KEY=gsk_your-key-here

# ---- Database ----
# DATABASE_URL is what the app connects with. It MUST be a role that is neither superuser nor BYPASSRLS
# (the app refuses to start otherwise), because row-level security does not apply to those roles.
# Required when MODE is public-preview or prod. Local mode defaults to the gap_app role of the
# Docker Compose Postgres (password APP_DB_PASSWORD, default gap_app).
# DATABASE_URL=postgresql://gap_app:<password>@localhost:5432/rag_platform
# MIGRATION_DATABASE_URL is the owner role, used only by `alembic upgrade head` and scripts/admin.
# Falls back to DATABASE_URL (which then needs table-owner rights).
# MIGRATION_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/rag_platform
# APP_DB_PASSWORD=<password of the gap_app role; used by docker compose and scripts/setup_db.sh>

# ---- Authentication ----
# API keys need no setting: create them with scripts/admin/identity.py. To also accept JWTs set ONE of
# JWT_JWKS_URL (asymmetric keys) or JWT_SECRET (HS256, at least 32 characters), plus issuer and audience.
# The token must carry sub (the principal UUID in `principals`), tenant_id (that principal's tenant) and scope / scopes.
# JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# JWT_SECRET=<random string, 32+ characters>
# JWT_ISSUER=https://idp.example.com/
# JWT_AUDIENCE=gap-api

# ---- Web edge ----
# PREVIEW_PRINCIPAL_ID is the principal id (a UUID, not a key) that a public-preview visitor gets a read-only
# session for. Only used when MODE=public-preview. It must not be set when MODE=prod.
# PREVIEW_PRINCIPAL_ID=<principal uuid>

# ---- UI ----
# The UI needs no key and no env file. It signs in at POST /v1/session, and Vite proxies /v1 to the API (API_URL, default http://localhost:8000).

# ---- Redis ----
# Required when MODE is public-preview or prod.
# REDIS_URL=redis://localhost:6379

# ---- Observability ----
# Export OpenTelemetry traces. Unset means spans are created but never exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LOG_LEVEL=INFO

# ---- Embeddings ----
# Override embedding dimension (default: 768, standardized across all modes)
# EMBEDDING_DIM=768

# ---- Guardrails ----
# Override guardrail thresholds (defaults: max 1000 chars, confidence floor 0.45)
# MAX_QUERY_LENGTH=1000
# CONFIDENCE_FLOOR=0.45

# ---- Object store (the ObjectStore port; nothing calls it yet, raw files by hash arrive in Sprint 007) ----
# OBJECT_STORE=local            # local (default) or s3
# OBJECT_STORE_DIR=data/objects
# For s3 (Cloudflare R2, MinIO or S3) all four must be set:
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=<bucket>
# S3_ACCESS_KEY_ID=<key id>
# S3_SECRET_ACCESS_KEY=<secret>
# S3_REGION=auto

# Trust (Sprint 008, ADR-0012). Never put a real key in this file.
# RECEIPT_SIGNING_KEY=                # Ed25519 private key, base64 of 32 raw bytes. Required in public-preview and prod; local makes a throwaway key
# When the API and a separate worker run (compose `worker`, `python -m workers`), set the SAME key in both, or the
# worker's purge checkpoints are signed with a key the API does not list. Make one with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# RECEIPT_PREVIOUS_PUBLIC_KEYS=       # comma separated base64 public keys of earlier signing keys (after a rotation)
# DECISION_RETENTION_DAYS=90          # how long decision records are kept; a tenant may set its own
# RETENTION_SCHEDULE_INTERVAL_SECONDS=3600  # how often a worker looks for expired records (0 turns it off)
# PURGE_BATCH_SIZE=1000
# DAILY_COST_CAP_USD=10               # per tenant per UTC day; a tenant policy may lower it
# METRICS_PUBLIC=                     # /metrics open when true (default true in local, false elsewhere; false needs an admin key)
# WORKER_METRICS_PORT=0               # serve the worker's own /metrics on this port (0 is off)
# GRAFANA_URL=                        # shown as a link on the Trust page, for example http://localhost:3000

# Jobs and workers (Sprint 007). `python -m workers` runs ingestion and agent runs; the API answers 202 and a worker does the work.
# EVENT_BUS=outbox                    # outbox (default: events commit with the change) or inprocess
# AGENT_RUNTIME=queued                # queued (default: a run is a job), inprocess, or openshell (the worker runs each run in a sandbox, see below)
# AGENT_SYNC_WAIT_SECONDS=25          # how long /v1/agent/query waits before it answers 202
# JOB_LEASE_SECONDS=60                # a running job renews its lease; a lost lease lets another worker take it
# JOB_MAX_ATTEMPTS=5
# JOB_BACKOFF_BASE_SECONDS=2          # retry delay is base * 2^attempts, with jitter
# WORKER_CONCURRENCY=1
# WORKER_HEALTH_FILE=/tmp/worker-health
# EMBEDDED_WORKERS=0                  # >0 runs workers inside the API process (one-container hosting)
# EMBEDDED_RELAY=false                # true relays the outbox from the API process

# Sandboxed agent runs (Sprint 009, ADR-0009, docs/runbooks/openshell.md). Only used with AGENT_RUNTIME=openshell.
# SANDBOX_GATEWAY_URL=http://172.17.0.1:8000   # this API as the sandbox sees it: the sandbox's only network route. Required. Not loopback.
# OPENSHELL_IMAGE=                    # workload image with python3, a user "sandbox" and /sandbox/work (unset: OpenShell's default image, which has no python3)
# OPENSHELL_ENDPOINT=                 # gateway host:port (unset: the active gateway of the OpenShell CLI configuration)
# OPENSHELL_WORKSPACE=default
# SANDBOX_CPU=1
# SANDBOX_MEMORY=512Mi
# SANDBOX_WALL_SECONDS=300            # also the life of the run token, plus a minute
# SANDBOX_WORK_DIR=/sandbox/work      # the one writable directory; it must exist in the image
# SANDBOX_READ_ONLY_PATHS=/usr,/lib,/lib64,/bin,/sbin
# SANDBOX_NETWORK_BINARIES=/usr/bin/python3*   # real paths or globs of the executables that may open the route (not symlinks)
