{
  "components": {
    "schemas": {
      "AgentCitation": {
        "description": "Mirrors schemas.py Citation exactly.",
        "properties": {
          "chunk_index": {
            "title": "Chunk Index",
            "type": "integer"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          },
          "relevance_score": {
            "title": "Relevance Score",
            "type": "number"
          },
          "source_filename": {
            "title": "Source Filename",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "source_filename",
          "chunk_index",
          "relevance_score",
          "excerpt"
        ],
        "title": "AgentCitation",
        "type": "object"
      },
      "AgentRequest": {
        "properties": {
          "enable_verifier": {
            "default": true,
            "description": "Whether to verify the drafted answer against retrieved chunks before returning it",
            "title": "Enable Verifier",
            "type": "boolean"
          },
          "max_iterations": {
            "default": 6,
            "description": "Max retrieve_chunks calls before forcing synthesis",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Iterations",
            "type": "integer"
          },
          "max_verify_retries": {
            "default": 1,
            "description": "How many times verification can send the query back for more retrieval",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Max Verify Retries",
            "type": "integer"
          },
          "namespace": {
            "default": "default",
            "description": "Document scope hint for the agent",
            "title": "Namespace",
            "type": "string"
          },
          "question": {
            "description": "The compliance question to research",
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AgentRequest",
        "type": "object"
      },
      "AgentResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "citations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/AgentCitation"
            },
            "title": "Citations",
            "type": "array"
          },
          "confidence": {
            "default": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "flag_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flag Reason"
          },
          "flagged": {
            "default": false,
            "title": "Flagged",
            "type": "boolean"
          },
          "model_used": {
            "default": "",
            "title": "Model Used",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "reasoning_steps": {
            "items": {
              "type": "string"
            },
            "title": "Reasoning Steps",
            "type": "array"
          },
          "tool_calls_made": {
            "title": "Tool Calls Made",
            "type": "integer"
          },
          "total_cost_usd": {
            "default": 0.0,
            "title": "Total Cost Usd",
            "type": "number"
          },
          "total_time_seconds": {
            "title": "Total Time Seconds",
            "type": "number"
          },
          "verification_notes": {
            "default": "",
            "title": "Verification Notes",
            "type": "string"
          },
          "verified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified"
          }
        },
        "required": [
          "question",
          "answer",
          "reasoning_steps",
          "tool_calls_made",
          "total_time_seconds"
        ],
        "title": "AgentResponse",
        "type": "object"
      },
      "Body_ingest_v1_ingest_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_ingest_v1_ingest_post",
        "type": "object"
      },
      "FeedbackRequest": {
        "properties": {
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "endpoint": {
            "title": "Endpoint",
            "type": "string"
          },
          "rating": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Rating",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "endpoint",
          "rating"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "db": {
            "title": "Db",
            "type": "string"
          },
          "embedding": {
            "default": "unknown",
            "title": "Embedding",
            "type": "string"
          },
          "mode": {
            "default": "",
            "title": "Mode",
            "type": "string"
          },
          "redis": {
            "title": "Redis",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "uptime_seconds": {
            "default": 0,
            "title": "Uptime Seconds",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "redis",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IngestResponse": {
        "properties": {
          "chunks_deleted": {
            "default": 0,
            "title": "Chunks Deleted",
            "type": "integer"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "status": {
            "default": "new",
            "title": "Status",
            "type": "string"
          },
          "throughput_chunks_per_second": {
            "title": "Throughput Chunks Per Second",
            "type": "number"
          },
          "total_chunks": {
            "title": "Total Chunks",
            "type": "integer"
          },
          "total_time_seconds": {
            "title": "Total Time Seconds",
            "type": "number"
          }
        },
        "required": [
          "document_id",
          "namespace",
          "total_chunks",
          "total_time_seconds",
          "throughput_chunks_per_second"
        ],
        "title": "IngestResponse",
        "type": "object"
      },
      "SearchRequest": {
        "properties": {
          "namespace": {
            "default": "default",
            "description": "Scope to search within",
            "title": "Namespace",
            "type": "string"
          },
          "query": {
            "description": "Natural language query to search against stored chunks",
            "title": "Query",
            "type": "string"
          },
          "rerank": {
            "default": true,
            "description": "Whether to apply cross-encoder reranking after retrieval",
            "title": "Rerank",
            "type": "boolean"
          },
          "retrieval_mode": {
            "default": "hybrid",
            "description": "Retrieval strategy: vector_only, bm25_only, or hybrid (default)",
            "pattern": "^(vector_only|bm25_only|hybrid)$",
            "title": "Retrieval Mode",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "description": "Number of chunks to retrieve",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "flag_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flag Reason"
          },
          "flagged": {
            "default": false,
            "title": "Flagged",
            "type": "boolean"
          },
          "needs_clarification": {
            "title": "Needs Clarification",
            "type": "boolean"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "rerank_applied": {
            "default": false,
            "title": "Rerank Applied",
            "type": "boolean"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "title": "Results",
            "type": "array"
          },
          "total_results": {
            "title": "Total Results",
            "type": "integer"
          }
        },
        "required": [
          "query",
          "answer",
          "confidence",
          "needs_clarification",
          "results",
          "total_results"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SearchResult": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "document_id",
          "namespace",
          "content",
          "score",
          "metadata"
        ],
        "title": "SearchResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "API key (gap_<prefix>_<secret>) or JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "RAG Platform API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/v1/agent/query": {
      "post": {
        "operationId": "agent_query_v1_agent_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Agent Query",
        "tags": [
          "agent"
        ]
      }
    },
    "/v1/analytics/summary": {
      "get": {
        "description": "Return cost and usage breakdown for the last N days.\n\nBreaks down total spend and request volume by day, endpoint,\nnamespace, and model. Used to power the frontend Analytics page.\nAll figures are derived from the usage_log table written by\nFinOpsMiddleware.\n\nPrerequisite: namespace is only accurate after the cache-hit namespace\nfix (bug 1.2) \u2014 rows written before that fix carry namespace='global'.",
        "operationId": "analytics_summary_v1_analytics_summary_get",
        "parameters": [
          {
            "description": "Number of days to look back",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 7,
              "description": "Number of days to look back",
              "maximum": 90,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Analytics Summary",
        "tags": [
          "analytics"
        ]
      }
    },
    "/v1/config": {
      "get": {
        "description": "Return all platform constants the frontend needs to render correctly.\n\nNamespaces, budget limits, rate limits, guardrail thresholds, and\nagent defaults are all derived from config.py at request time \u2014\nthere is no caching, so the frontend always gets the live values.",
        "operationId": "get_config_v1_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Config",
        "tags": [
          "config"
        ]
      }
    },
    "/v1/documents": {
      "get": {
        "description": "List all ingested documents from the document registry.\n\nReturns document metadata including content hash (for deduplication\nvisibility), chunk count, source filename, and last ingested timestamp.\nFilter by namespace to show only documents in a specific scope.",
        "operationId": "list_documents_v1_documents_get",
        "parameters": [
          {
            "description": "Filter by namespace. Omit to list all.",
            "in": "query",
            "name": "namespace",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by namespace. Omit to list all.",
              "title": "Namespace"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Documents",
        "tags": [
          "documents"
        ]
      }
    },
    "/v1/feedback": {
      "post": {
        "description": "Record a thumbs up or down rating for a specific response.\n\nrequest_id must be the X-Query-ID header value from the original\n/search or /agent/query response. This ties the feedback row back\nto the exact request in usage_log.",
        "operationId": "submit_feedback_v1_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Submit Feedback",
        "tags": [
          "feedback"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_check_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/v1/ingest": {
      "post": {
        "operationId": "ingest_v1_ingest_post",
        "parameters": [
          {
            "in": "query",
            "name": "namespace",
            "required": false,
            "schema": {
              "default": "default",
              "title": "Namespace",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "document_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Document Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_ingest_v1_ingest_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Ingest"
      }
    },
    "/v1/quality-report": {
      "get": {
        "description": "Return thumbs up/down counts aggregated by endpoint.\n\nUse this to track answer quality trends over time. A rising\nthumbs-down rate indicates a retrieval or generation regression.",
        "operationId": "quality_report_v1_quality_report_get",
        "parameters": [
          {
            "description": "Number of days to look back",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Number of days to look back",
              "maximum": 365,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Quality Report",
        "tags": [
          "feedback"
        ]
      }
    },
    "/v1/search": {
      "post": {
        "operationId": "search_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Search"
      }
    }
  }
}
